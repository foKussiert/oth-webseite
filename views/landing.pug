doctype html
html(lang="de")
  head
    meta(charset="UTF-8")
    title OTHer – Landing
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.3.0/font/bootstrap-icons.css")
    link(rel="icon", href="/img/logo.svg", type="image/svg+xml")
    link(rel="stylesheet", href="/styles.css")
  body
    .container
      .row
        .col-3
          .logo-container
            img.logo(src="/img/logo.svg", alt="OTHer Logo")
          .fs-3
            i.bi.bi-house-door-fill
            align-middle  Startseite
          .fs-3 
            a.login-button(href="/login") Login
          .fs-3 
            a.register-button(href="/register") Registrieren
        .col-6
          h2 Willkommen bei OTHer! 
          each o in others
            .other-row
              img.avatar(src=`/img/users/${o.profile_pic}.png`, alt="avatar")
              .other-info
                .other-header
                  span.username= o.name
                  span.handle @#{o.name}
                  span.created= o.created
                p.other-text= o.text        
        .col-3


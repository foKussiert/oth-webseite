doctype html
html(lang="de")
  head
    meta(charset="UTF-8")
    title Registrieren
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.3.0/font/bootstrap-icons.css")
    link(rel="icon", href="/img/logo.svg", type="image/svg+xml")
    link(rel="stylesheet", href="/styles.css")
  body
    .container
      .row
        .col-3
          .logo-container
            img.logo(src="/img/logo.svg", alt="OTHer Logo")
          .fs-3
            i.bi.bi-house-door-fill
            a.align-middle(href="/") Startseite
          a(href="/login").button-full Login
          a(href="/register").button-full Registrieren
        .col-6
          h2 Registrieren
          form(method="POST", action="/register", class="form-area")
            label(for="name") Benutzername
            input.form-control(type="text", id="name", name="name", placeholder="Nutzername", required)

            label(for="password") Passwort
            input.form-control(type="password", id="password", name="password", placeholder="Passwort", required)

            label(for="birthday") Geburtsdatum
            input.form-control(type="date", id="birthday", name="birthday", required)

            label(for="profile_pic") Profilbild-Dateiname (ohne `.png`)
            input.form-control(type="text", id="profile_pic", name="profile_pic", placeholder="z.B. maxi", required)

            label(for="bio_text") Kurzbiografie
            textarea.form-control(id="bio_text", name="bio_text", placeholder="erzähl was")

            button.btn(type="submit") Registrieren

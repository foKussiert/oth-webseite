doctype html
html(lang="de")
  head
    meta(charset="UTF-8")
    title Nutzerübersicht
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.3.0/font/bootstrap-icons.css")
    link(rel="icon", href="/img/logo.svg", type="image/svg+xml")
    link(rel="stylesheet", href="/styles.css")
  body
    .container
      .row
        .col-3
          .logo-container
            img.logo(src="/img/logo.svg", alt="OTHer Logo")
          .fs-3
            i.bi.bi-house-door-fill
            a.align-middle(href="/dashboard") Startseite
          .fs-3
            i.bi.bi-person-fill
            a.align-middle(href="/profile") Profil
          .fs-3
            i.bi.bi-people-fill
            a.align-middle.active-link(href="/users") Nutzer
          .fs-3
            a.other-button(href="/other") Othern
          .fs-3
            a.logout-button(href="/logout") Logout

        .col-6
          h2 Registrierte Nutzer
          each user in users
            .user-row
              img.avatar(src=`/img/users/${user.profile_pic}.png`, alt="avatar")
              .user-info
                span.username= user.name
                span.handle @#{user.name}
              if user.is_following
                form(method="post", action=`/unfollow/${user.user_id}`)
                  button.btn.btn-danger(type="submit") Entfolgen
              else
                form(method="post", action=`/follow/${user.user_id}`)
                  button.btn.btn-success(type="submit") Folgen
        .col-3
          form(method="get", action="/users")
            .input-group.mb-3
              span.input-group-text
                i.bi.bi-search
              input.form-control(type="text", name="query", placeholder="Other durchsuchen...", value=query || "")
